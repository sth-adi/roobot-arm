diff -ruN a/api/handlers.py b/api/handlers.py
--- a/api/handlers.py
+++ b/api/handlers.py
@@ -10,7 +10,14 @@
 from motion.packets import CompileAnglePacket
 
 
+def _targets_are_live():
+    now = time.time()
+    return sum(1 for t in state.target_times if now - t <= state.LIVE_WINDOW_S) >= state.LIVE_MIN_TARGETS
+
+
 class Handler(BaseHTTPRequestHandler):
+    protocol_version = "HTTP/1.1"   # the board keeps one connection open instead of connecting for every request
+    timeout = 5                     # and a board that vanishes frees its connection after this many seconds
 
     def log_message(self, format, *args):
         # The dashboard asks these two every second: leave them out of the console so real events stay visible.
@@ -102,7 +109,7 @@
                 return
 
             try:
-                angle_packet = CompileAnglePacket(current_cords, state.TargetCords, state.TargetSpeed, state.STEPS_PER_MM)
+                angle_packet = CompileAnglePacket(current_cords, state.TargetCords, state.TargetSpeed, state.STEPS_PER_MM, live=_targets_are_live())
             except (ValueError, ZeroDivisionError, OverflowError) as error:
                 # A refused move says why (title only: the status line must be one short line); the full reason is printed.
                 reason = getattr(error, "title", "") or "unreachable"
@@ -159,6 +166,7 @@
                 return
             state.TargetCords = candidate
             state.TargetSpeed = speed
+            state.target_times = (state.target_times + [time.time()])[-8:]
             # An in-flight packet keeps its own target snapshot and ID.
