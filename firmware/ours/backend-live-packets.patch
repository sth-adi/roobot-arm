--- a/GlobalVariables.py
+++ b/GlobalVariables.py
@@ -14,6 +14,12 @@
 STEPS_PER_MM = 5  # Only used by the original planner; the checked planner (motion/safe_planner.py) updates at PLAN_RATE_HZ.
 MAX_JOINT_DPS = 30.0  # No joint is asked to move faster than this (deg/s); a move is slowed down as a whole to keep to it.
 PLAN_RATE_HZ = 50.0   # Servo commands per second in a packet.
+# While targets keep arriving (the dashboard following a controller) a packet covers only the first LIVE_PACKET_S seconds of the way, at a constant speed,
+# so the arm chases a target that is at most about that old. "Keep arriving" = LIVE_MIN_TARGETS targets within the last LIVE_WINDOW_S seconds.
+LIVE_PACKET_S = 0.5
+LIVE_WINDOW_S = 0.6
+LIVE_MIN_TARGETS = 3
+target_times = []     # when the last few targets were set
 
 controller_state = {}
