diff -ruN a/motion/packets.py b/motion/packets.py
--- a/motion/packets.py	2026-10-29 14:10:20.293469201 +0000
+++ b/motion/packets.py	2026-10-29 14:10:20.315905439 +0000
@@ -18,37 +18,13 @@
 
 
 def CompileAnglePacket(StartingCords: Coordinates, EndingCords: Coordinates, Speed, StepsPmm):
+    """Same inputs and output as before (StepsPmm is no longer used), but every step is checked first.
 
-    XDiff = EndingCords.X - StartingCords.X
-    YDiff = EndingCords.Y - StartingCords.Y
-    ZDiff = EndingCords.Z - StartingCords.Z
-    ADiff = EndingCords.A - StartingCords.A
-
-    Distance = math.sqrt(XDiff**2 + YDiff**2 + ZDiff**2)
-    if Speed <= 0 or StepsPmm <= 0:
-        raise ValueError("Speed and StepsPmm must be greater than zero")
-    if Distance == 0:
-        return []
-
-    TimeTaken = Distance / Speed
-    Steps = max(1, math.ceil(Distance * StepsPmm))
-    StepTiming = TimeTaken / Steps
-
-    MovementSet = []
-
-    InitialAngles = InverseKim(StartingCords)
-
-    MovementSet.append(FormatPacketEntry(0, InitialAngles))
-
-    for step in range(1, Steps + 1):
-        fraction = step / Steps
-        MidTargetCords = Coordinates(
-            StartingCords.X + XDiff * fraction,
-            StartingCords.Y + YDiff * fraction,
-            StartingCords.Z + ZDiff * fraction,
-            StartingCords.A + ADiff * fraction,
-        )
-        target_angles = InverseKim(MidTargetCords)
-        MovementSet.append(FormatPacketEntry(step * StepTiming, target_angles))
-
-    return MovementSet
+    Raises motion.safe_planner.PlanError (a ValueError with code, title, detail and hint) for a path that is unreachable, outside the
+    calibrated joint limits, too close to the base axis or needs a joint to jump. No packet is produced for such a move."""
+    import GlobalVariables as state
+    from motion import safe_planner
+
+    start = (StartingCords.X, StartingCords.Y, StartingCords.Z, StartingCords.A)
+    end = (EndingCords.X, EndingCords.Y, EndingCords.Z, EndingCords.A)
+    return safe_planner.plan(start, end, state.calibration_data["jointLimits"], Speed, state.MAX_JOINT_DPS, state.PLAN_RATE_HZ)["lines"]
