diff -ruN a/src/network/BackendConnection.h b/src/network/BackendConnection.h
--- a/src/network/BackendConnection.h	2026-10-31 01:10:49.057129634 +0000
+++ b/src/network/BackendConnection.h	2026-10-31 01:10:49.086386692 +0000
@@ -5,3 +5,44 @@
 #include <HTTPClient.h>
 #include <WiFiClientSecure.h>
 #include "../config/Secrets.h"
+
+// Ours: with BACKEND_PLAIN_HTTP (set in the generated Secrets.h) the backend is a plain-http server on the local network and HOST
+// is "address:port" (e.g. "192.168.1.20:8001"). Without it the original behaviour is kept: https on port 443, certificate not checked.
+#ifdef BACKEND_PLAIN_HTTP
+typedef WiFiClient BackendClient;
+#define BACKEND_SCHEME "http://"
+inline void BackendTrust(WiFiClient&) {}
+#else
+typedef WiFiClientSecure BackendClient;
+#define BACKEND_SCHEME "https://"
+inline void BackendTrust(WiFiClientSecure& c) { c.setInsecure(); }
+#endif
+
+// Ours: how long to wait before asking again when there was nothing to do (the original always waited 100 ms, even right after a move).
+#ifndef BACKEND_IDLE_MS
+#define BACKEND_IDLE_MS 40
+#endif
+
+// Ours: one connection to the backend, kept open between requests (GET /UpdateMovement, POST /movement-complete) instead of connecting for every one.
+// After a failed request call .stop() on the client so the next request connects again.
+inline BackendClient& BackendSharedClient()
+{
+    static BackendClient client;
+    static bool ready = false;
+    if (!ready) {
+        BackendTrust(client);
+        ready = true;
+    }
+    return client;
+}
+
+inline HTTPClient& BackendSharedHttp()
+{
+    static HTTPClient http;
+    static bool ready = false;
+    if (!ready) {
+        http.setReuse(true);
+        ready = true;
+    }
+    return http;
+}
