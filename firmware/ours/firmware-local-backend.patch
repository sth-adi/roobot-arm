diff -ruN a/src/network/BackendConnection.h b/src/network/BackendConnection.h
--- a/src/network/BackendConnection.h
+++ b/src/network/BackendConnection.h
@@ -5,3 +5,15 @@
 #include <HTTPClient.h>
 #include <WiFiClientSecure.h>
 #include "../config/Secrets.h"
+
+// Ours: with BACKEND_PLAIN_HTTP (set in the generated Secrets.h) the backend is a plain-http server on the local network and HOST
+// is "address:port" (e.g. "192.168.1.20:8001"). Without it the original behaviour is kept: https on port 443, certificate not checked.
+#ifdef BACKEND_PLAIN_HTTP
+typedef WiFiClient BackendClient;
+#define BACKEND_SCHEME "http://"
+inline void BackendTrust(WiFiClient&) {}
+#else
+typedef WiFiClientSecure BackendClient;
+#define BACKEND_SCHEME "https://"
+inline void BackendTrust(WiFiClientSecure& c) { c.setInsecure(); }
+#endif
