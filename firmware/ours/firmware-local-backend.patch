+// Ours: packets carry fractions of a degree, so write the pulse width directly instead of rounding to whole degrees (the same 500 to 2400 us
+// over 0 to 180 degrees as attach() in StartupProcess.h). Inversion works as in ServoCommandAngle.
+int ServoCommandMicroseconds(int jointIndex, float logicalAngle)
+{
+    const float clamped = fminf(fmaxf(logicalAngle, 0.0f), 180.0f);
+    const bool inverted = JointLims[jointIndex][0] > JointLims[jointIndex][1];
+    const float command = inverted ? 180.0f - clamped : clamped;
+    return static_cast<int>(lroundf(500.0f + (2400.0f - 500.0f) * command / 180.0f));
+}
