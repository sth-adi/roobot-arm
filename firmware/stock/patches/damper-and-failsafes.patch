+                        targetAngles.s3 - commandedAngles.s3, targetAngles.s4 - commandedAngles.s4};
+    for (int i = 0; i < 4; ++i) {
+        if (fabsf(degrees(a[i])) > LagHoldDegrees) return true;
+    }
+    return false;
+}
