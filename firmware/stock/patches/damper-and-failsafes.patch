+// True when the whole-degree servo command differs from the last one sent.  Re-sending an unchanged command (or one
+// that only differs by floating-point noise) would power a released servo up again for nothing.
+bool ServoCommandChanged(const RobotAngles& angles)
+{
+    static int lastDegrees[4] = {-1, -1, -1, -1};
+    bool changed = false;
+    for (int jointIndex = 0; jointIndex < 4; ++jointIndex) {
+        const int degreesNow = static_cast<int>(lroundf(degrees(JointAngleAt(angles, jointIndex))));
+        if (degreesNow != lastDegrees[jointIndex]) {
+            lastDegrees[jointIndex] = degreesNow;
+            changed = true;
+        }
+    }
+    return changed;
+}
+
+// True while any joint is further than LagHoldDegrees behind its target.
+bool ArmIsLagging()
