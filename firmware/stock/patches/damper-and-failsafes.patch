+// Move commandedAngles toward goal, no joint faster than the limit and all four scaled together. True on arrival.
+bool SlewCommandedAngles(const RobotAngles& goal, float seconds)
+{
+    const float step = radians(MaxJointDegPerSecond) * seconds;
+    const float d[4] = {goal.s1 - commandedAngles.s1, goal.s2 - commandedAngles.s2,
+                        goal.s3 - commandedAngles.s3, goal.s4 - commandedAngles.s4};
+    float biggest = 0.0f;
+    for (int i = 0; i < 4; ++i) {
+        if (fabsf(d[i]) > biggest) biggest = fabsf(d[i]);
+    }
+    if (biggest <= step || biggest < 1e-9f) {
+        commandedAngles = goal;
+        return true;
+    }
+    const float k = step / biggest;
+    commandedAngles = {commandedAngles.s1 + d[0] * k, commandedAngles.s2 + d[1] * k,
+                       commandedAngles.s3 + d[2] * k, commandedAngles.s4 + d[3] * k};
+    return false;
+}
