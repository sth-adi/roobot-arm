 constexpr int MaxSequencePoses = 20;
 
-// GET /sequence -> {"id":N,"poses":[[x,y,z,angle,action],...]}, action 0 none, 1 grab (magnet on), 2 release (magnet off).
+// GET /sequence -> {"id":N,"poses":[[x,y,z,angle,action,speed],...]}, action 0 none, 1 grab (magnet on), 2 release (magnet off);
+// speed (optional, deg/s) is the joint speed limit for the move into that pose, 0 or missing = the normal limit.
 // Returns the number of poses (0 = an empty sequence, which means "stop"), or -1 if the request or the body failed.
-int FetchSequence(int& id, RobotPosition* poses, int* actions, int maxPoses)
+int FetchSequence(int& id, RobotPosition* poses, int* actions, float* speeds, int maxPoses)
 {
     if (WiFi.status() != WL_CONNECTED) {
         return -1;
@@ -349,8 +350,18 @@ int FetchSequence(int& id, RobotPosition* poses, int* actions, int maxPoses)
                 ++p;
             }
         }
+        float speed = 0.0f;                 // the sixth number is optional: an older server sends five
+        if (*p && *p != ']') {
+            char* speedEnd = nullptr;
+            const float parsed = strtof(p, &speedEnd);
+            if (speedEnd != p) {
+                speed = parsed;
+                p = speedEnd;
+            }
+        }
         poses[count] = {v[0], v[1], v[2], v[3]};
         actions[count] = static_cast<int>(v[4]);
+        speeds[count] = speed > 0.0f ? speed : 0.0f;
         ++count;
     }
     return count;
