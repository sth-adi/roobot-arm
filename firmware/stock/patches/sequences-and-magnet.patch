+// ---- sequences (added): the server holds one sequence at a time; "seqId" in the controller packet says there is a new one ----
+constexpr int MaxSequencePoses = 20;
+
+// GET /sequence -> {"id":N,"poses":[[x,y,z,angle,action],...]}, action 0 none, 1 grab (magnet on), 2 release (magnet off).
+// Returns the number of poses (0 = an empty sequence, which means "stop"), or -1 if the request or the body failed.
+int FetchSequence(int& id, RobotPosition* poses, int* actions, int maxPoses)
+{
+    if (WiFi.status() != WL_CONNECTED) {
+        return -1;
+    }
+    WiFiClientSecure client;
+    client.setInsecure();
+    HTTPClient http;
+    const String url = "https://" + String(HOST) + "/sequence";
+    if (!http.begin(client, url)) {
+        return -1;
+    }
+    const int statusCode = http.GET();
+    if (statusCode != HTTP_CODE_OK) {
+        Serial.printf("Sequence GET failed: %d\n", statusCode);
+        http.end();
+        return -1;
+    }
+    const String body = http.getString();
+    http.end();
+
+    float idValue = 0.0f;
+    if (!ReadControllerValue(body, "id", idValue)) {
+        return -1;
+    }
+    id = static_cast<int>(idValue);
+
+    const int listStart = body.indexOf("\"poses\"");
+    if (listStart < 0) {
+        return -1;
+    }
+    const char* p = body.c_str() + listStart;
+    p = strchr(p, '[');                 // the outer list
+    if (!p) {
+        return -1;
+    }
+    ++p;
+    int count = 0;
+    while (count < maxPoses) {
+        p = strchr(p, '[');
+        if (!p) {
+            break;
+        }
+        ++p;
+        float v[5];
+        for (int i = 0; i < 5; ++i) {
+            char* end = nullptr;
+            v[i] = strtof(p, &end);
+            if (end == p) {
+                return -1;
+            }
+            p = end;
+            while (*p == ',' || *p == ' ') {
+                ++p;
+            }
+        }
+        poses[count] = {v[0], v[1], v[2], v[3]};
+        actions[count] = static_cast<int>(v[4]);
+        ++count;
+    }
+    return count;
+}
+
+// POST /armstate: where the arm is, so whatever is giving the orders (the dashboard, an AI) can see it.
+void SendArmState(const String& json)
+{
+    if (WiFi.status() != WL_CONNECTED) {
+        return;
+    }
+    WiFiClientSecure client;
+    client.setInsecure();
+    HTTPClient http;
+    const String url = "https://" + String(HOST) + "/armstate";
+    if (!http.begin(client, url)) {
+        return;
+    }
+    http.addHeader("Content-Type", "application/json");
+    const int statusCode = http.POST(json);
+    if (statusCode != HTTP_CODE_NO_CONTENT) {
+        Serial.printf("State POST failed: %d\n", statusCode);
+    }
+    http.end();
+}
